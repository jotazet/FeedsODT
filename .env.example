# Skopiuj do .env i dostosuj. Compose wczytuje .env automatycznie.

# Port, pod którym nginx wystawia feedy na hoście.
FEEDSODT_PORT=8090

# --- Krok `shape` (profil "shape" w docker-compose) ---------------------------
# Wycinek OSM, po którym routowana jest geometria. Musi pokrywać obszar feedu.
# Dla POLREGIO: cała Polska, https://download.geofabrik.de/europe/poland-latest.osm.pbf
FEEDSODT_OSM_FILE=./osm/poland-latest.osm.pbf

# Pamięć dla silników. Import grafu ogólnopolskiego jest pamięciożerny (bus
# sięga 2,6 GB); przy gotowym grafie w shaper/cache/ starcza dużo mniej —
# zmierzone po starcie: rail 475 MB, bus 66 MB.
RAIL_JAVA_OPTS=-Xmx2g -Xms256m
BUS_JAVA_OPTS=-Xmx3g -Xms256m

# Porty silników na hoście (do podglądu; fetcher gada z nimi po sieci compose).
FEEDSODT_RAIL_PORT=45889
FEEDSODT_BUS_PORT=45890

# --- Harmonogram ---------------------------------------------------------------
# Co ile dni odpytujemy źródła. Slot każdego z nich (dzień + godzina) stoi
# w config/sources.toml jako run_day i run_at.
FEEDSODT_INTERVAL_DAYS=3

# Równoległe zapytania do silników routujących. Na słabszej maszynie zejdź
# do 4 — czas rośnie, ale pamięć i obciążenie CPU spadają.
FEEDSODT_SHAPE_WORKERS=8
