# Skopiuj do .env i dostosuj. Compose wczytuje .env automatycznie.

# Port, pod którym nginx wystawia feedy na hoście.
FEEDSODT_PORT=8090

# --- Krok `shape` (profil "shape" w docker-compose) ---------------------------
# Wycinek OSM, po którym routowana jest geometria. Musi pokrywać obszar feedu.
# Dla POLREGIO: cała Polska, https://download.geofabrik.de/europe/poland-latest.osm.pbf
FEEDSODT_OSM_FILE=./osm/poland-latest.osm.pbf

# Pamięć dla silników. Wartości poniżej są pod PRACĘ NA GOTOWYM GRAFIE —
# zmierzone zużycie to 53–70 MB (kolej) i 835–875 MB (autobus), razem ok. 1 GB.
# Mieści się na maszynie 4 GB obok fetchera (125 MB) i nginksa (7 MB).
#
# IMPORT grafu ogólnopolskiego to inna liga: sięga 2,6 GB i pod tymi wartościami
# się nie uda. Na małej maszynie NIE importuj — skopiuj gotowy shaper/cache/
# z większej. Szczegóły w shaper/README.md.
RAIL_JAVA_OPTS=-Xmx1g -Xms128m
BUS_JAVA_OPTS=-Xmx1500m -Xms128m

# Twarde limity kontenerów — zabezpieczenie przed położeniem hosta.
# Podnieś tylko na czas importu grafu, na maszynie, która ma zapas.
# Limit kontenera = -Xmx + zapas na pamięć JVM poza stertą (~500–700 MB).
RAIL_MEM_LIMIT=1200m
BUS_MEM_LIMIT=2200m

# Ile rdzeni może zająć każdy silnik. Chroni resztę maszyny, gdy żądanie się
# zapętli (Jetty nie przerywa obliczeń po zerwaniu połączenia przez klienta).
# Na 2 vCPU ustaw 1.
RAIL_CPUS=2
BUS_CPUS=2

# Porty silników na hoście (do podglądu; fetcher gada z nimi po sieci compose).
FEEDSODT_RAIL_PORT=45889
FEEDSODT_BUS_PORT=45890

# --- Harmonogram ---------------------------------------------------------------
# Co ile dni odpytujemy źródła. Slot każdego z nich (dzień + godzina) stoi
# w config/sources.toml jako run_day i run_at.
FEEDSODT_INTERVAL_DAYS=3

# Równoległe zapytania do silników routujących. Przy 2 vCPU ustaw 4 — czas
# rośnie, ale maszyna zostaje używalna w trakcie kształtowania.
FEEDSODT_SHAPE_WORKERS=8
